  "notes": {
    "event_family_v1": "disaster_transport",
    "event_subtype_v1": "aviation_accident",
    "source_id": "ntsb_avall_mdb_v1",
    "analysis_calendar_date": "UTC calendar date from NTSB ev_date; sub-day UTC when ev_tmzn==UTC and ev_time parses as HHMM.",
    "severity_policy": "severity_magnitude duplicates fatalities_total at index; severity_bucket uses fatality bands + hull_destroyed_non_fatal.",
    "aviation_fields": "fatalities_total (inj_tot_f), aircraft_hull_loss (any aircraft.damage==DEST), operator_region (first oper_country), operation_phase (first phase_flt_spec).",
    "deduplication_v1": "dedupe_cluster_id equals event_id; one row per NTSB ev_id.",
    "quality_flags": "outside_spine; ntsb_time_imputed_or_partial when time not high-confidence; ntsb_missing_iso3_country.",
    "ingest_policy": "ev_type ACC only; raw ev_year>=1990; require finite dec_latitude/dec_longitude. Current avall.mdb populates decimals from ~2008 onward, so the spatial core is ~2008\u2013present.",
    "geographic_scope": "NTSB census is US civil aviation\u2013centric; ev_country is often USA but not enforced."
  },
